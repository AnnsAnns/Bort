# Copy to `.env` next to the binary and fill in. Every value except the tokens
# has a sensible default.

# --- Discord ---------------------------------------------------------------
# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Comma separated Discord user IDs allowed to run /link. There is no
# "everyone" mode on purpose - this pushes to a live website.
ALLOWED_USERS=

# Register the command in this guild only, so it shows up immediately instead
# of waiting for Discord to propagate a global command. Leave empty to go global.
GUILD_ID=

# --- Repository ------------------------------------------------------------
# Fine grained personal access token, scoped to this repository, with
# "Contents: Read and write". Nothing else is needed.
GIT_TOKEN=

GIT_REMOTE=https://github.com/AnnsAnns/Bort.git
GIT_BRANCH=main
# Ignored by GitHub for PATs, but git insists on a username.
GIT_USERNAME=foobar

# Where the working clone is kept. Gets `git reset --hard`ed on every publish,
# so point it somewhere disposable - never at a repo you work in.
WORKDIR=./workdir

LINKS_PATH=src/content/links.json
COMMIT_NAME=Bort Linkbot
COMMIT_EMAIL=bort@annsann.eu

# --- Scraping --------------------------------------------------------------
FETCH_TIMEOUT_SECS=20
MAX_PAGE_BYTES=4194304
# USER_AGENT=BortLinkbot/0.1.0 (+https://annsann.eu/links)

# --- Logging ---------------------------------------------------------------
RUST_LOG=bort_linkbot=info,warn
