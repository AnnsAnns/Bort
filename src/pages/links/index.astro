---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Box from "../../components/Box.astro";
import { dayOfMonth, getSortedLinks, groupByMonth } from "../../utils/links";

const months = groupByMonth(await getSortedLinks());
---

<BaseLayout title="Links" desc="Cool links and articles I found elsewhere">
  <section class="h-full flex justify-center py-2 sm:py-4">
    <Box title="🔗 Cool Links" className="w-full max-w-3xl">
      <div class="flex flex-col gap-1 pt-2">
        <p class="text-sm text-base-text-color/70">
          Articles, posts and other things from around the web that I thought
          were worth keeping. Everything here was written by someone else.
        </p>
        <a
          href="/links/rss.xml"
          class="text-sm underline w-fit text-base-text-color/70 hover:text-base-text-color"
        >
          📡 Subscribe via RSS
        </a>
      </div>

      {
        months.length === 0 && (
          <p class="py-8 text-center font-headerf text-xl text-base-text-color/60">
            Nothing here yet 🐸
          </p>
        )
      }

      <div class="flex flex-col pt-4 pb-2">
        {
          months.map((month) => (
            <section>
              <h2
                id={month.key}
                class="font-headerf text-xl md:text-2xl flex items-center gap-3 pt-4 pb-1"
              >
                {month.label}
                <span class="grow border-b-2 border-base-text-color/20" />
              </h2>

              {month.links.map((link) => (
                <a
                  id={link.id}
                  href={link.data.url}
                  rel="noopener"
                  class="group block py-1.5 px-2 -mx-2 rounded-sm transition-colors hover:bg-base-text-color/10 focus-visible:bg-base-text-color/10"
                >
                  <div class="flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
                    <span class="shrink-0 w-6 text-sm tabular-nums text-base-text-color/50">
                      {dayOfMonth(link.data.addedDate)}
                    </span>
                    <span class="font-semibold group-hover:underline">
                      {link.data.title}
                    </span>
                    <span class="hidden sm:block grow min-w-6 border-b border-dotted border-base-text-color/30" />
                    <span class="ml-auto sm:ml-0 shrink-0 text-sm text-base-text-color/60">
                      {link.data.site}
                    </span>
                  </div>

                  {link.data.comment && (
                    <p class="pl-8 pr-2 text-sm">{link.data.comment}</p>
                  )}

                  {(link.data.author ||
                    link.data.pubDate ||
                    link.data.tags?.length) && (
                    <div class="pl-8 pr-2 flex flex-wrap items-baseline gap-x-2 text-xs text-base-text-color/60">
                      {link.data.author && <span>by {link.data.author}</span>}
                      {link.data.pubDate && (
                        <time datetime={link.data.pubDate.toISOString()}>
                          {link.data.pubDate.toLocaleDateString("en-us", {
                            year: "numeric",
                            month: "short",
                            day: "numeric",
                            timeZone: "UTC",
                          })}
                        </time>
                      )}
                      {link.data.tags?.map((tag) => <span>#{tag}</span>)}
                    </div>
                  )}
                </a>
              ))}
            </section>
          ))
        }
      </div>
    </Box>
  </section>
</BaseLayout>
